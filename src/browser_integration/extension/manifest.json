{
  "manifest_version": 3,
  "name": "Autenticador FIDO2/Passkey Virtual",
  "version": "1.0.0",
  "description": "Substitui navigator.credentials.get para usar um autenticador FIDO2 virtual local.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "virtual-fido2@typedbywill.local",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Autenticador FIDO2 Virtual"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
